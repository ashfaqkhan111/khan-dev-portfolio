#!/bin/bash

echo "-------------------"
echo "BASH FILE ORGANIZER "
echo "-------------------"

read -p "Enter directory to organize : " DIR

if [ ! -d "$DIR" ]; then
echo "Error : Directory does not exist"
exit 1
fi

mkdir -p "$DIR/Documents"
mkdir -p "$DIR/Images"
mkdir -p "$DIR/Videos"
mkdir -p "$DIR/Music"
mkdir -p "$DIR/Archive"
mkdir -p "$DIR/Others"


